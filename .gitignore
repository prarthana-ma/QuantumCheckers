# Virtual environments and build artefacts
.venv/
venv/
env/
build/
dist/
*.egg-info/

# Byte-compiled and cached files
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Jupyter / Colab
.ipynb_checkpoints/

# Generated experiment output: JSONL logs, replay payloads, PNGs.
# Keep the directory itself, drop the contents.
results/*
!results/.gitkeep

# Local scratch data (raw upstream clones, captured API payloads)
data/logs/

# Any JSONL anywhere, so a stray log is never committed by accident
*.jsonl

# Editor and OS noise
.env
.env.*
!.env.example
.vscode/
.idea/
.DS_Store
Thumbs.db
