[TEMPLATE]
# Optional IBM Quantum execution for the live-collapse path. Set these in your shell or
# in your host's secret store; never in NEXT_PUBLIC_* and never commit real values.
#
# Setting QISKIT_IBM_TOKEN enables the live-game hardware path: each collapse
# (Observe, or a Level-4 decoherence expiry) submits one measurement shot to IBM Quantum
# and writes the measured square into game state. There is no simulator or random fallback
# on that path -- a failed or unusable outcome refuses the move and leaves the state
# unchanged. Leave it unset to run the ordinary offline game.
#
# NEVER prefix this with NEXT_PUBLIC_: that would inline the token into the client bundle
# and publish it to every visitor.
QISKIT_IBM_TOKEN=
# Recommended instance CRN. Without one, only the Open Plan is selected.
IBM_QUANTUM_INSTANCE=
# Optional backend name. Leave unset -- ibm_brisbane, ibm_kyiv and ibm_torino are all
# retired, so the code discovers the least-busy operational device at runtime.
IBM_QUANTUM_BACKEND=
# Optional seconds to wait for a hardware job result (default 180).
IBM_QUANTUM_TIMEOUT=
# Optional hard off-switch: set to 1 to force hardware mode off on a server.
QCHECKERS_DISABLE_HARDWARE=
